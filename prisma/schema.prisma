generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        String     @id @default(cuid())
  name      String     @unique
  streamers Streamer[]

  @@map("roles")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Admin {
  id          String    @id @default(uuid()) // Must match Supabase Auth UID
  email       String    @unique
  name        String    @default("Sub Admin")
  role        AdminRole @default(ADMIN)
  uniqueSlug  String?   @unique @map("unique_slug") // e.g., "fams-commander"
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("admins")
}

model Streamer {
  id               String    @id
  name             String    // RP Name / Streamer Name
  role             Role?     @relation(fields: [roleId], references: [id])
  channelId        String    @map("channel_id")
  youtubeId        String?   @default("") @map("youtube_id")
  avatar           String
  status           String    @default("offline") 
  
  // --- IN CHARACTER (LORE & ROSTER) DATA ---
  divisions        String[]  @default(["MEMBER"]) // E.g., "FAMS", "DONN", "SWAG", "MEMBER"
  lore             String?   @db.Text           // Background story
  factionStatus    String    @default("ACTIVE") // "ACTIVE", "OUT", "CK"
  combatStats      Json?     // To store specific stats like kill count
  

  createdAt        DateTime  @default(now()) @map("created_at")
  position         Int       @default(autoincrement())
  lastChecked      DateTime? @map("last_checked")
  lastVideoCheck   DateTime? @map("last_video_check")
  latestVideoId    String?   @map("latest_video_id")
  activeLiveChatId String?   @map("active_live_chat_id")
  roleId           String?   @map("role_id")

  @@map("streamers")
}

model Backsound {
  id           String   @id @default(cuid())
  filename     String
  url          String
  size         Int
  createdAt    DateTime @default(now()) @map("created_at")
  originalName String?  @map("original_name")

  @@map("backsounds")
}

model Discussion {
  id        String   @id @default(uuid())
  title     String?
  name      String
  username  String?
  message   String   @db.Text
  isAdmin   Boolean  @default(false)
  isPinned  Boolean  @default(false)
  reactions Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  parentId  String?  @map("parent_id")
  parent    Discussion?  @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Discussion[] @relation("DiscussionReplies")

  @@map("discussions")
}

model CustomSticker {
  id        String   @id @default(uuid())
  name      String   
  imageUrl  String   @map("image_url") 
  createdAt DateTime @default(now()) @map("created_at")

  @@map("custom_stickers")
}

model HeroBackground {
  id           String   @id @default(cuid())
  filename     String
  url          String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("hero_backgrounds")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
